{
  "name": "dsh-traffic-statistics",
  "version": "1.0.0",
  "description": "DSH 公网流量统计：按聊天 / 工具 / 插件 / 其它 四类分账，TCP 精确计量 + UDP 估算。仅支持 Linux 宿主。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "traffic",
    "bandwidth",
    "statistics"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  }
}
